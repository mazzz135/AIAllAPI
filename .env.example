# AIAll API 运行配置
# 宝塔 Python 项目：项目名 AIAllAPI，根目录 /www/wwwroot/AIAllAPI，端口 2999
# 说明：AIALL_* 为当前前缀；历史部署的 TRAEAPI_* 变量仍然生效（AIALL_* 优先）

AIALL_HOST=0.0.0.0
AIALL_PORT=2999
AIALL_DATA_DIR=/www/wwwroot/AIAllAPI/data

# 首次初始化管理员；留空则自动生成随机密码到 data/initial_admin.txt
AIALL_ADMIN_USERNAME=admin
AIALL_ADMIN_PASSWORD=

# 凭据加密密钥；留空会自动生成 data/secret.key（请备份）
AIALL_SECRET_KEY=

# 会话与管理台
AIALL_SESSION_HOURS=72
AIALL_TRUST_PROXY=1

# 模型与上游
AIALL_DEFAULT_MODEL=deepseek-v4.1-flash
AIALL_IDE_VERSION=3.4.0
AIALL_IDE_VERSION_CODE=20260716
AIALL_OAUTH_HOST=https://api.trae.cn
AIALL_AGENT_HOST=https://trae-api-cn.mchost.guru
AIALL_UG_HOST=https://api.trae.cn
AIALL_CONSOLE_HOST=https://www.trae.cn
# Trae 官方授权页只接受 http://127.0.0.1:<port>/authorize
AIALL_TRAE_CALLBACK_PORT=57321

# 调度与日志
AIALL_CHECKIN_TIME=10:05
AIALL_AUTO_CHECKIN=1
AIALL_LOG_RETENTION_DAYS=30
AIALL_MAX_CONCURRENT_PER_ACCOUNT=2
AIALL_UPSTREAM_TIMEOUT=180
AIALL_FIRST_EVENT_TIMEOUT=60
